def fact(n: int): int {
    if n <= 1 { return 1; }
    return n * fact(n - 1);
}

let a: int[] = [4, 2, 8];
let grid: bool[2, 3];
let sum: int = 0;
for (let i: int = 0; i < length(a); ++i) {
    if a[i] == 2 { continue; }
    sum = sum + a[i];
}
while sum != 0 {
    --sum;
    break;
}
let m: int = sum > 10 -> sum | 10;
print fact(5);
