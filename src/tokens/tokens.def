// TOKEN(имя в C++, имя в выводе tokens, написание в mfy или "")
// порядок согласован с приоритетом
// ключевые слова
TOKEN(Let,      "LET",      "let")
TOKEN(Def,      "DEF",      "def")
TOKEN(Type,     "TYPE",     "type")
TOKEN(If,       "IF",       "if")
TOKEN(Else,     "ELSE",     "else")
TOKEN(While,    "WHILE",    "while")
TOKEN(For,      "FOR",      "for")
TOKEN(Break,    "BREAK",    "break")
TOKEN(Continue, "CONTINUE", "continue")
TOKEN(Return,   "RETURN",   "return")
TOKEN(Print,    "PRINT",    "print")
TOKEN(And,      "AND",      "and")
TOKEN(Or,       "OR",       "or")
TOKEN(Not,      "NOT",      "not")
TOKEN(True,     "TRUE",     "true")
TOKEN(False,    "FALSE",    "false")
TOKEN(Null,     "NULL",     "null")
TOKEN(Int,      "INT",      "int")
TOKEN(Real,     "REAL",     "real")
TOKEN(Bool,     "BOOL",     "bool")
TOKEN(Str,      "STR",      "str")
TOKEN(Void,     "VOID",     "void")
TOKEN(Reactive, "REACTIVE", "reactive")
TOKEN(Include,  "INCLUDE",  "include")
TOKEN(Enum,     "ENUM",     "enum")

// имена и литералы
TOKEN(Modword,  "MODWORD",  "")   // [pc]+
TOKEN(Ident,    "IDENT",    "")   // [a-zA-Z_][a-zA-Z_0-9]*
TOKEN(IntLit,   "INT_LIT",  "")   // [0-9]+
TOKEN(RealLit,  "REAL_LIT", "")   // [0-9]+ "." [0-9]+ ([eE][+-]?[0-9]+)? | [0-9]+ [eE][+-]?[0-9]+
TOKEN(StrLit,   "STR_LIT",  "")   // "([^"\\\n] | \\[ntr\\"])*"

// операторы и разделители
TOKEN(Plus,      "PLUS",       "+")
TOKEN(Minus,     "MINUS",      "-")
TOKEN(Star,      "STAR",       "*")
TOKEN(Slash,     "SLASH",      "/")
TOKEN(Percent,   "PERCENT",    "%")
TOKEN(Inc,       "INC",        "++")
TOKEN(Dec,       "DEC",        "--")
TOKEN(Assign,    "ASSIGN",     "=")
TOKEN(Walrus,    "WALRUS",     ":=")
TOKEN(Eq,        "EQ",         "==")
TOKEN(Ne,        "NE",         "!=")
TOKEN(Lt,        "LT",         "<")
TOKEN(Le,        "LE",         "<=")
TOKEN(Gt,        "GT",         ">")
TOKEN(Ge,        "GE",         ">=")
TOKEN(CondArrow, "COND_ARROW", "->")
TOKEN(Pipe,      "PIPE",       "|")
TOKEN(PtrArrow,  "PTR_ARROW",  "->")
TOKEN(Dollar,    "DOLLAR",     "$")
TOKEN(Amp,       "AMP",        "&")
TOKEN(Dot,       "DOT",        ".")
TOKEN(LParen,    "LPAREN",     "(")
TOKEN(RParen,    "RPAREN",     ")")
TOKEN(LBracket,  "LBRACKET",   "[")
TOKEN(RBracket,  "RBRACKET",   "]")
TOKEN(LBrace,    "LBRACE",     "{")
TOKEN(RBrace,    "RBRACE",     "}")
TOKEN(Comma,     "COMMA",      ",")
TOKEN(Semi,      "SEMI",       ";")
TOKEN(Colon,     "COLON",      ":")

TOKEN(End,       "EOF",        "")